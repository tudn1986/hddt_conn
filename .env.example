# Copy to .env and replace every CHANGE_ME value.
HDDT_DOMAIN=hddt.example.com
ACME_EMAIL=admin@example.com
# Generate: openssl rand -base64 48
HDDT_ADMIN_TOKEN=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
HDDT_IMAGE_TAG=1.3.0-public

# Session and resource policy
HDDT_SESSION_IDLE_MS=1800000
HDDT_SESSION_ABSOLUTE_MS=28800000
HDDT_MAX_SESSIONS=500
HDDT_RATE_LIMIT_PER_MINUTE=300
# Docker bridge proxy CIDR; narrow this to your proxy network when known.
HDDT_TRUST_PROXY_CIDRS=172.16.0.0/12
HDDT_TVAN_BATCH_MAX_BYTES=268435456
HDDT_MEMORY_LIMIT=1g
HDDT_CPU_LIMIT=2.0
