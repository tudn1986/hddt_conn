{
  "name": "hddt",
  "version": "1.3.0-rc.2",
  "private": true,
  "description": "hddt-conn v1.3.0-rc.2 - WebUI kết nối và quản lý hóa đơn điện tử Việt Nam",
  "type": "module",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:8288": "node scripts/dev-8288.mjs",
    "dev:web": "vite",
    "build": "npm run clean && npm run build:server && npm run build:web",
    "clean": "node scripts/clean.mjs",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "start": "node scripts/start.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "package:portable": "node scripts/package-portable.mjs",
    "package:win-x64": "node scripts/package-portable.mjs --platform win32 --arch x64",
    "package:mac-arm64": "node scripts/package-portable.mjs --platform darwin --arch arm64",
    "package:mac-x64": "node scripts/package-portable.mjs --platform darwin --arch x64",
    "package:source": "node scripts/package-source.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && node scripts/check-scripts.mjs",
    "verify": "npm run lint && npm run test && npm run build && npm run smoke"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.3",
    "parse5": "^8.0.1",
    "pino": "^10.3.1",
    "playwright-core": "^1.63.0",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "antd": "^5.29.3",
    "dayjs": "^1.11.23",
    "esbuild": "^0.28.2",
    "postject": "1.0.0-alpha.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.19.0"
}
